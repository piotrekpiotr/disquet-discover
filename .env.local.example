# Copy to `.env.local` for local dev, or set equivalents in your host's env UI.
# Never commit `.env.local`.

# --- Admin auth ----------------------------------------------------------
# Password the curator types on /admin/login. Keep it long and random; this
# is the only thing standing between the moderation queue and the internet.
ADMIN_PASSWORD=change-me-to-a-long-random-string

# Optional separate secret used to sign session cookies. When unset, the
# code falls back to ADMIN_PASSWORD. Set this when you want to rotate one
# without invalidating the other (change secret -> signs out every
# session; change password -> new passwords accepted but existing sessions
# stay valid).
ADMIN_SESSION_SECRET=another-long-random-string

# --- Canonical site URL --------------------------------------------------
# Used for absolute URLs in metadata, OpenGraph, RSS, sitemap, JSON-LD.
# In production this is whatever the deployed domain is; the code falls
# back to the public domain when unset.
NEXT_PUBLIC_SITE_URL=https://disquet.co

# --- Optional: description generation ------------------------------------
# Only needed if you run `scripts/write-descriptions.mjs`. Accepts an
# Anthropic key (via ANTHROPIC_API_KEY) or any compatible key via
# LLM_API_KEY. Never commit this value.
# LLM_API_KEY=sk-...

# --- Newsletter ----------------------------------------------------------
# Buttondown API key (https://buttondown.email/settings/programming).
# Without this the site still renders the signup form and the subscribe
# endpoint will accept POSTs in dev (logged, not sent) but real sends will
# refuse to run.
BUTTONDOWN_API_KEY=

# Support + from headers. Both optional; defaults are hello@disquet.co and
# "Disquet Discover".
NEWSLETTER_SUPPORT_EMAIL=hello@disquet.co
NEWSLETTER_FROM_NAME=Disquet Discover

# Shared secret for the cron webhook at /api/cron/send. Vercel Cron adds
# this as `Authorization: Bearer <CRON_SECRET>` automatically once set in
# the project's environment. GitHub Actions (or anything else) must pass
# the same header. Keep this long and random, rotate when a collaborator
# leaves.
CRON_SECRET=another-long-random-string
